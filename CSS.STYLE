body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f0f2f5;
}

.app {
  text-align: center;
  padding: 40px;
}

.question-box,
.result-box {
  background: white;
  max-width: 500px;
  margin: auto;
  padding: 30px;
  border-radius: 10px;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 15px;
  margin-top: 20px;
}

button {
  padding: 12px;
  border: none;
  background: #007bff;
  color: white;
  cursor: pointer;
  border-radius: 5px;
  font-size: 16px;
}

button:hover {
  background: #0056b3;
}
